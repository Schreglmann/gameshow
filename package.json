{
  "name": "gameshow",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --config vite.config.dev.ts",
    "dev:server": "cross-env UV_THREADPOOL_SIZE=32 tsx watch server/index.ts",
    "build:client:frontend": "vite build --config vite.config.frontend.ts",
    "build:client:admin": "vite build --config vite.config.admin.ts",
    "build:client:gamemaster": "vite build --config vite.config.gamemaster.ts",
    "build:client": "npm run build:client:frontend && npm run build:client:admin && npm run build:client:gamemaster",
    "build": "tsc -b && tsc -p tsconfig.server.json && npm run build:client",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.cjs",
    "start": "cross-env UV_THREADPOOL_SIZE=32 node dist/server/server/index.js",
    "postinstall": "node scripts/postinstall-hint.cjs",
    "validate": "tsx validate-config.ts",
    "validate-assets": "tsx validate-assets.ts",
    "fixtures": "tsx scripts/create-examples.ts",
    "normalize-audio": "tsx normalize-audio.ts",
    "media:encrypt": "tsx media-crypt.ts encrypt",
    "media:decrypt": "tsx media-crypt.ts decrypt",
    "sync:pull": "tsx sync-assets.ts pull",
    "sync": "tsx sync-assets.ts sync",
    "diagnose:sync": "tsx scripts/diagnose-sync-drift.ts",
    "push:drifted": "tsx scripts/push-drifted-to-nas.ts",
    "backup": "tsx backup-assets.ts",
    "fetch-movie-posters": "tsx fetch-movie-posters.ts",
    "whisper:install": "bash scripts/whisper-install.sh",
    "whisper:download-model": "tsx scripts/whisper-download-model.ts",
    "upscaler:install": "tsx scripts/install-upscaler.ts",
    "generate:hp-spells": "tsx generate-hp-spells.ts",
  "cities:generate": "tsx scripts/generate-city-dataset.ts",
    "bandle-sync": "node scripts/bandle-sync.cjs",
    "verify": "node scripts/verify-changed.cjs",
    "verify:staged": "node scripts/verify-changed.cjs --staged",
    "verify:full": "node scripts/verify-changed.cjs --full",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contracts": "vitest run tests/contracts",
    "test:related": "vitest related --run",
    "test:e2e": "npx playwright test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "contracts:lint": "npx @redocly/cli lint --config specs/api/redocly.yaml specs/api/openapi.yaml && npx --yes --package @asyncapi/cli@6.0.2 --package @asyncapi/studio@1.3.0 asyncapi validate specs/api/asyncapi.yaml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "canvas-confetti": "^1.9.4",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.1",
    "react-router-dom": "^7.18.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/ffprobe-static": "^2.0.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "all-the-cities": "^3.1.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^21.0.4",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
