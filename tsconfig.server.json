{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist/server",
    "declaration": true
  },
  "include": ["server/**/*.ts", "src/types/**/*.ts", "src/utils/teams.ts", "src/utils/rulesPreset.ts", "src/data/gameTypeInfo.ts"],
  "exclude": ["node_modules"]
}
