#!/bin/sh
# Only the gate CI cannot run: `config.json` and `games/*.json` are git-crypt
# encrypted in GitHub Actions, so the validator there sees ciphertext. Lint,
# both typechecks, `contracts:lint` and the full test suite run in
# `.github/workflows/ci.yml` on every push to every branch.
# See AGENTS.md §7 (Verification).
exec node --import tsx/esm validate-config.ts
